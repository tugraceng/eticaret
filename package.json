{
  "name": "eticaret-platform",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:seed": "prisma db seed",
    "dev:backend": "npm run dev -w @platform/backend",
    "dev:frontend": "npm run dev -w @platform/frontend",
    "build": "npm run db:generate && npm run build -w @platform/backend && npm run build -w @platform/frontend",
    "lint": "npm run lint -w @platform/backend -w @platform/frontend",
    "test:backend": "npm run test -w @platform/backend"
  },
  "devDependencies": {
    "@prisma/client": "^6.19.3",
    "@types/bcrypt": "^5.0.2",
    "bcrypt": "^5.1.1",
    "dotenv": "^16.6.1",
    "prisma": "^6.19.3",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=20"
  }
}
