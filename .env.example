# Root / shared
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/platform?schema=public"
# Prisma CLI (`prisma.config.ts`) kök `.env` ve isteğe bağlı `apps/backend/.env` dosyalarını yükler.

# Backend (apps/backend)
JWT_SECRET="change-me-in-production-use-long-random-string"
JWT_EXPIRES_IN="7d"
# İstemci kökeni(leri). Üretimde virgülle birden fazla verebilirsiniz: "https://site.com,https://www.site.com"
# Geliştirmede localhost, 127.0.0.1 ve [::1] üzerindeki tüm portlar ayrıca kabul edilir (tarayıcı adresi farkı).
CORS_ORIGIN="http://localhost:3000"
PORT=4000
# Reverse proxy (nginx, cloud load balancer) arkasında gerçek istemci IP'si ve rate limit için: 1
# TRUST_PROXY=1
# Birden fazla API instance: paylaşımlı rate limit için Redis (Boşsa bellek içi sayaç — tek pod için yeterli)
# REDIS_URL=redis://localhost:6379
# Misafir sepet throttle: varsayılan 48 istek / 60 sn (ms cinsinden süre)
# THROTTLE_TTL_MS=60000
# THROTTLE_LIMIT=48
# CDN / WAF: `/api/cart/guest-abandon`, `/api/auth/login` vb. için edge rate limit kuralları ayrıca önerilir.
# Yüklenen görsellerin yazıldığı klasör (göreli yol: çalışma dizini apps/backend ise apps/backend/uploads)
# UPLOAD_DIR=uploads
# Tarayıcıda kullanılacak tam taban URL (sonunda / yok). Boşsa http://localhost:PORT
# Üretimde API genel adresiniz: https://api.siteniz.com
# PUBLIC_UPLOAD_BASE_URL=http://localhost:4000
# Kampanya / terk edilmiş sepet e-postalarındaki mağaza linkleri (sonunda / yok). Boşsa localhost:3000 varsayılır.
# PUBLIC_STORE_URL=https://www.siteniz.com
# OAuth sonrası yönlendirme ve şifre sıfırlama linkleri (sonunda / yok). Örn. http://localhost:3000
# PUBLIC_WEB_URL=http://localhost:3000
# Google ile müşteri girişi (üçü de doluysa backend /auth/oauth/google açar; Google Cloud’da callback URL kaydedin)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_CALLBACK_URL=http://localhost:4000/api/auth/oauth/google/callback
# Kampanya e-postaları: her alıcıdan sonra ek bekleme (ms, 0=kapalı). Sağlayıcı rate limit ile birlikte kullanın.
# MARKETING_EMAIL_GAP_MS=150
# NetGSM SMS kampanyaları: alıcılar arası bekleme (ms). Boşsa e-posta ile aynı MARKETING_EMAIL_GAP_MS kullanılır.
# MARKETING_SMS_GAP_MS=200
# E-fatura sağlayıcısı: boş veya none = yalnızca yer tutucu kancası; gerçek entegrasyon için örn. foriba
# EINVOICE_PROVIDER=none

# --- Performans / Ölçüm ---
# Her HTTP isteği için structured JSON log. Log basmayı kapatmak için: off (default: açık)
# PERF_LOG=off
# Kaç ms üstü "slow" olarak WARN log'a yükseltilir (default: 20)
# PERF_SLOW_MS=20
# Prisma query event'i ile request başına queryCount takibi. Kapatmak için: off (default: açık)
# PERF_QUERY_LOG=off
# In-memory cache katmanı. Kapatmak için: off (ör. bench baseline ölçümünde)
# CACHE_ENABLED=off

# Frontend (apps/frontend)
NEXT_PUBLIC_API_URL="http://localhost:4000/api"
# Backend’de Google OAuth açıksa 1 yapın (giriş sayfasında Google düğmesi)
# NEXT_PUBLIC_GOOGLE_LOGIN=1
# Sunucu tarafı fetch'lerde bekleme süresi (ms); API yanıt vermezse sayfa takılı kalmayı azaltır
NEXT_PUBLIC_API_TIMEOUT_MS="12000"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_ROOT_DOMAIN="localhost:3000"
# Optional: use plain localhost without subdomain (?tenant= still works)
NEXT_PUBLIC_FALLBACK_TENANT=""

# Seed: mevcut DB'de popup başlığı boşsa örnek popup doldurulsun istemiyorsanız 1 yapın
# SEED_SKIP_SAMPLE_POPUP=1
# Mağaza yan sütun örneklerini (sol+sağ başlık boşken) doldurmayı atlamak için 1
# SEED_SKIP_SAMPLE_SHOP_RAILS=1
# Seed her çalıştığında örnek anasayfa (HomeSection) satırlarını silip yeniden yazar. Üretimde seed çalıştırıyorsanız ve vitrin düzeninizi korumak istiyorsanız:
# SEED_SKIP_HOME_SECTIONS=1